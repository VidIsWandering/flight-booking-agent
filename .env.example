# Copy this file to .env and fill in the values. Never commit the real .env.

# Required. A Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=your_api_key_here

# ---------------------------------------------------------------- optional
# Gemini model ID. Default: gemini-3.6-flash
# FLIGHT_AGENT_MODEL=gemini-3.6-flash

# A separate (for example smaller) model for the plan executors. Default: FLIGHT_AGENT_MODEL.
# FLIGHT_AGENT_EXECUTOR_MODEL=

# Sampling temperature. Leave unset to keep the model's default, which Google recommends
# for Gemini 3 models (lower values can cause loops and degraded reasoning).
# FLIGHT_AGENT_TEMPERATURE=

# Thinking level: minimal | low | medium | high. Default: the model's default.
# FLIGHT_AGENT_THINKING_LEVEL=

# Client retries on 429/5xx with exponential backoff, and per-request timeout.
# FLIGHT_AGENT_MAX_RETRIES=6
# FLIGHT_AGENT_TIMEOUT_S=120

# Client-side rate limit shared by all model calls, in requests per minute. Default: none
# FLIGHT_AGENT_REQUESTS_PER_MINUTE=

# Token prices in USD per million tokens, to report cost and enforce a cost budget.
# FLIGHT_AGENT_PRICE_INPUT_PER_MTOK=
# FLIGHT_AGENT_PRICE_OUTPUT_PER_MTOK=

# Replace the default Gemini client with your own: 'module:function' or
# 'path/to/file.py:function', called as function(model_id, settings) and returning a
# LangChain BaseChatModel (for routing, caching, or another client).
# FLIGHT_AGENT_MODEL_FACTORY=
